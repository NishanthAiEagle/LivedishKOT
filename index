<!DOCTYPE html>
<html lang="en" class="h-full bg-[#040204]">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>The Spice Bistro — 7-Star International Haute Gastronomy</title>
  
  <!-- Luxury Editorial Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800;900&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            bistro: {
              void: '#030204',
              obsidian: '#070407',
              surface: '#0f0910',
              elevated: '#170e19',
              gold: '#d8b26a',
              goldLight: '#f6e2b8',
              goldDim: '#9b7a38',
              velvet: '#5c1322',
              velvetDark: '#360912',
              emerald: '#00f59b',
              flame: '#ff4d2e',
              border: 'rgba(216, 178, 106, 0.16)'
            }
          },
          fontFamily: {
            cinzel: ['"Cinzel"', 'serif'],
            serif: ['"Cormorant Garamond"', 'Georgia', 'serif'],
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace']
          }
        }
      }
    }
  </script>

  <style>
    * { -webkit-tap-highlight-color: transparent; box-sizing: border-box; }
    body {
      background: #030204;
      color: #f6e2b8;
      font-family: 'Plus Jakarta Sans', sans-serif;
      user-select: none;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    .hide-scroll::-webkit-scrollbar { display: none; }
    .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }

    /* 7-Star Glassmorphism */
    .glass-card {
      background: linear-gradient(135deg, rgba(23, 14, 25, 0.78) 0%, rgba(11, 7, 12, 0.88) 100%);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(216, 178, 106, 0.18);
    }
    .glass-panel-elevated {
      background: linear-gradient(135deg, rgba(30, 18, 32, 0.94) 0%, rgba(15, 9, 16, 0.98) 100%);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1px solid rgba(216, 178, 106, 0.28);
    }

    /* Subtle Animated Gold Hairline Sheen */
    @keyframes goldGlint {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .gold-sheen-bar {
      background: linear-gradient(90deg, transparent 0%, rgba(246, 226, 184, 0.35) 50%, transparent 100%);
      background-size: 200% 100%;
      animation: goldGlint 6s infinite linear;
    }

    /* Ambient Breathing Glows */
    @keyframes beaconBreathe {
      0%, 100% { transform: scale(1); box-shadow: 0 0 20px -2px rgba(216, 178, 106, 0.45), 0 0 45px -8px rgba(92, 19, 34, 0.6); }
      50% { transform: scale(1.05); box-shadow: 0 0 35px 4px rgba(216, 178, 106, 0.75), 0 0 60px 0px rgba(92, 19, 34, 0.85); }
    }
    .beacon-glow { animation: beaconBreathe 3.4s infinite ease-in-out; }

    /* Haptic Press Response */
    .haptic-click:active {
      transform: scale(0.96);
      filter: brightness(1.15);
      transition: transform 0.12s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Sheet animations */
    .sheet-spring-up {
      animation: springUp 0.38s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes springUp {
      from { transform: translateY(105%); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    /* Culinary Animation 1: Tandoor Embers Flare */
    @keyframes emberFlare {
      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 4px #ff5722); opacity: 0.9; }
      50% { transform: scale(1.18); filter: drop-shadow(0 0 12px #ff9800); opacity: 1; }
    }
    .anim-ember { animation: emberFlare 1.8s infinite ease-in-out; }

    /* Culinary Animation 2: Sauté Steam Wisps */
    @keyframes steamDrift {
      0% { transform: translateY(0) scale(0.9); opacity: 0.4; }
      50% { transform: translateY(-4px) scale(1.1); opacity: 0.85; }
      100% { transform: translateY(-8px) scale(1.2); opacity: 0; }
    }
    .anim-steam { animation: steamDrift 2.2s infinite ease-in-out; }

    /* Culinary Animation 3: Dum Simmer Rings */
    @keyframes aromaPulse {
      0% { transform: scale(0.85); opacity: 0.8; }
      50% { transform: scale(1.25); opacity: 0.2; }
      100% { transform: scale(0.85); opacity: 0.8; }
    }
    .anim-aroma { animation: aromaPulse 2.6s infinite ease-in-out; }

    /* Culinary Animation 4: Gold Plating Twinkle */
    @keyframes goldTwinkle {
      0%, 100% { transform: rotate(0deg) scale(0.9); filter: drop-shadow(0 0 2px #d8b26a); }
      50% { transform: rotate(180deg) scale(1.25); filter: drop-shadow(0 0 10px #f6e2b8); }
    }
    .anim-twinkle { animation: goldTwinkle 3s infinite linear; }
  </style>
</head>
<body class="min-h-screen flex justify-center bg-bistro-void text-bistro-goldLight pb-32">

  <!-- Mobile Max Device Container -->
  <div class="w-full max-w-md min-h-screen flex flex-col relative bg-bistro-void border-x border-bistro-border/30 overflow-x-hidden shadow-[0_0_100px_rgba(0,0,0,0.9)]">

    <canvas id="ambientGoldCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-0 opacity-40"></canvas>

    <!-- Top Luxury Suite HUD Header -->
    <header class="sticky top-0 z-40 glass-card border-b border-bistro-border/40 px-4 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="relative w-10 h-10 rounded-2xl bg-gradient-to-br from-bistro-velvet to-bistro-surface border border-bistro-gold/40 flex items-center justify-center shadow-lg shadow-bistro-velvet/40">
          <span class="font-cinzel text-lg font-bold text-bistro-gold tracking-tight">SB</span>
          <span class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 rounded-full bg-bistro-emerald border-2 border-bistro-void animate-pulse"></span>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="text-[9px] font-mono tracking-widest text-bistro-gold uppercase font-bold px-1.5 py-0.5 rounded bg-bistro-gold/10 border border-bistro-gold/20">7-STAR PRIVATE SUITE</span>
          </div>
          <h1 class="font-cinzel text-xs font-bold tracking-widest text-bistro-goldLight uppercase mt-0.5">ALCOVE SALON IV</h1>
        </div>
      </div>

      <!-- Header Utilities: Dedicated Bill Folio (🧾) & Live Pass Status -->
      <div class="flex items-center gap-2">
        <button onclick="openKitchenFolioModal()" id="hudCookingIndicator" class="haptic-click px-2.5 py-1.5 rounded-xl bg-bistro-surface/90 border border-bistro-gold/30 text-[10px] font-mono text-bistro-gold flex items-center gap-1.5" title="Live Kitchen Line Update">
          <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
          <span id="hudCookingLabel">3 DISHES ON PASS</span>
        </button>

        <!-- DEDICATED BILL FOLIO ICON -->
        <button onclick="openBillFolioModal()" class="haptic-click p-2 rounded-xl bg-bistro-surface border border-bistro-gold/50 text-bistro-gold hover:border-bistro-goldLight hover:bg-bistro-gold/10 flex items-center justify-center shadow-lg relative" title="View Table Bill Folio">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"/></svg>
          <span id="folioCountBadge" class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-bistro-velvet border border-bistro-gold/60 text-[9px] font-mono font-bold flex items-center justify-center text-bistro-goldLight">3</span>
        </button>
      </div>
    </header>

    <div class="sticky top-[58px] z-30 bg-[#070408]/95 backdrop-blur-md border-b border-bistro-border/30 px-3 py-2 flex items-center justify-between text-xs">
      <div class="flex items-center gap-1.5 overflow-x-auto hide-scroll py-0.5">
        <span class="text-[9px] font-mono uppercase tracking-widest text-bistro-gold font-bold shrink-0 mr-1 flex items-center gap-1">
          <span>🛡️ DIETARY SHIELD:</span>
        </span>
        <button onclick="toggleDietShield('satvik')" id="shieldBtnSatvik" class="haptic-click px-2.5 py-1 rounded-full text-[10px] font-mono border border-bistro-border bg-bistro-surface text-bistro-goldLight/70 flex items-center gap-1 shrink-0 transition-all">
          <span>🌿 Satvik (Jain)</span>
        </button>
        <button onclick="toggleDietShield('glutenFree')" id="shieldBtnGluten" class="haptic-click px-2.5 py-1 rounded-full text-[10px] font-mono border border-bistro-border bg-bistro-surface text-bistro-goldLight/70 flex items-center gap-1 shrink-0 transition-all">
          <span>🌾 Gluten-Free</span>
        </button>
        <button onclick="toggleDietShield('keto')" id="shieldBtnKeto" class="haptic-click px-2.5 py-1 rounded-full text-[10px] font-mono border border-bistro-border bg-bistro-surface text-bistro-goldLight/70 flex items-center gap-1 shrink-0 transition-all">
          <span>🥩 Keto Tandoor</span>
        </button>
      </div>
    </div>

    <!-- MAIN SCROLLABLE APP BODY -->
    <main class="flex-1 relative z-10 p-4 space-y-4">

      <section class="glass-card rounded-3xl p-4 border border-bistro-gold/40 relative overflow-hidden group shadow-[0_0_35px_rgba(216,178,106,0.12)]">
        <div class="gold-sheen-bar absolute top-0 left-0 right-0 h-1"></div>
        <div class="flex items-center justify-between mb-2">
          <span class="px-2.5 py-0.5 rounded-full bg-gradient-to-r from-bistro-velvet to-bistro-velvetDark border border-bistro-gold/40 text-[9px] font-mono tracking-widest uppercase text-bistro-goldLight font-bold">
            👑 CHEF'S DEGUSTATION FLIGHT
          </span>
          <span class="text-[10px] font-mono text-bistro-gold font-semibold">+ SAVE 18% AOV</span>
        </div>
        
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1">
            <h2 class="font-cinzel text-lg font-bold text-bistro-goldLight leading-tight">Royal Awadhi Grand Degustation</h2>
            <p class="text-xs text-bistro-goldLight/75 mt-1 font-light leading-relaxed">
              Curated 3-Course Sommelier Flight: <span class="text-bistro-gold font-medium">Zafrani Paneer Mille-Feuille</span>, <span class="text-bistro-gold font-medium">24K Dal Bukhara</span> &amp; <span class="text-bistro-gold font-medium">Shahi Tukda 24K</span> with vintage pairings.
            </p>
            <div class="flex items-center gap-2 mt-2 text-[10px] font-mono text-bistro-goldLight/60">
              <span>⏱️ Course Cadence: 45 Mins</span>
              <span>•</span>
              <span class="text-bistro-emerald font-semibold">Includes 2 Cellar Pairings</span>
            </div>
          </div>
          <div class="flex flex-col items-end justify-between self-stretch shrink-0">
            <div class="text-right">
              <span class="text-[10px] font-mono line-through text-bistro-goldLight/40 block">₹1,740</span>
              <span class="font-mono text-lg font-bold text-bistro-gold">₹1,420</span>
            </div>
            <button onclick="addTastingFlightToCart()" class="haptic-click px-3.5 py-2 rounded-xl bg-gradient-to-r from-bistro-gold via-[#e9c788] to-bistro-gold text-bistro-void font-cinzel font-bold text-[11px] tracking-wider uppercase shadow-lg shadow-bistro-gold/20 mt-2">
              + STAGE FLIGHT
            </button>
          </div>
        </div>
      </section>

      <section class="space-y-2">
        <div class="flex items-center justify-between text-xs px-1">
          <span class="font-mono text-[10px] uppercase tracking-widest text-bistro-gold font-bold">HAUTE GASTRONOMY CHAPTERS</span>
          <span class="text-[10px] font-mono text-bistro-goldLight/50" id="dishCountLabel">20 DISHES TOTAL</span>
        </div>
        <div class="flex items-center gap-2 overflow-x-auto hide-scroll pb-1">
          <button onclick="filterChapter('all')" class="chapter-btn active px-3.5 py-1.5 rounded-full text-xs font-mono font-medium whitespace-nowrap bg-bistro-gold text-bistro-void shadow transition-all">ALL CHAPTERS</button>
          <button onclick="filterChapter('ch1')" class="chapter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium whitespace-nowrap bg-bistro-surface border border-bistro-border text-bistro-goldLight/80 hover:text-bistro-goldLight transition-all">I: STARTERS</button>
          <button onclick="filterChapter('ch2')" class="chapter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium whitespace-nowrap bg-bistro-surface border border-bistro-border text-bistro-goldLight/80 hover:text-bistro-goldLight transition-all">II: THE BHATTHI</button>
          <button onclick="filterChapter('ch3')" class="chapter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium whitespace-nowrap bg-bistro-surface border border-bistro-border text-bistro-goldLight/80 hover:text-bistro-goldLight transition-all">III: IMPERIAL CURRIES</button>
          <button onclick="filterChapter('ch4')" class="chapter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium whitespace-nowrap bg-bistro-surface border border-bistro-border text-bistro-goldLight/80 hover:text-bistro-goldLight transition-all">IV: DUM BIRYANI & BREADS</button>
          <button onclick="filterChapter('ch5')" class="chapter-btn px-3.5 py-1.5 rounded-full text-xs font-mono font-medium whitespace-nowrap bg-bistro-surface border border-bistro-border text-bistro-goldLight/80 hover:text-bistro-goldLight transition-all">V: SWEET ALCHEMY</button>
        </div>
      </section>

      <section id="dishesMatrix" class="space-y-3.5">
        <!-- Rendered dynamically by JavaScript -->
      </section>
    </main>

    <div id="stagingCartDock" class="fixed bottom-0 left-0 right-0 max-w-md mx-auto z-40 p-3 bg-gradient-to-t from-bistro-void via-bistro-void/95 to-transparent transition-transform translate-y-48">
      <div class="glass-panel-elevated rounded-2xl p-3.5 shadow-[0_0_40px_rgba(216,178,106,0.28)] border border-bistro-gold/50 flex flex-col gap-2.5">
        <div class="flex items-center justify-between">
          <div class="cursor-pointer" onclick="openCartReviewSheet()">
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-bistro-gold animate-ping"></span>
              <span class="text-[10px] font-mono text-bistro-gold uppercase font-bold tracking-wider" id="cartStagingCount">0 DISHES STAGED</span>
            </div>
            <span class="text-lg font-bold font-mono text-bistro-goldLight" id="cartStagingTotal">₹0</span>
          </div>

          <button onclick="openCartReviewSheet()" class="haptic-click px-5 py-2.5 rounded-xl bg-gradient-to-r from-bistro-gold to-[#f6e2b8] text-bistro-void font-cinzel font-bold text-xs tracking-wider uppercase shadow-md flex items-center gap-1.5">
            <span>REVIEW & DISPATCH</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </button>
        </div>
      </div>
    </div>

    <div id="ambientLivingPill" class="fixed bottom-3 left-4 max-w-[240px] z-30 glass-card border border-bistro-gold/40 rounded-full px-3.5 py-2 shadow-xl flex items-center gap-2 cursor-pointer haptic-click hover:border-bistro-gold transition-all" onclick="openKitchenFolioModal()">
      <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping shrink-0"></span>
      <div class="truncate">
        <span class="text-[10px] font-mono font-bold text-bistro-gold block leading-tight">🔥 IN KITCHEN PREP</span>
        <span class="text-[9px] text-bistro-goldLight/70 font-mono truncate block" id="ambientPillSub">3 dishes cooking on embers</span>
      </div>
    </div>

    <div class="fixed bottom-3 right-4 z-40">
      <button onclick="toggleButlerModal(true)" class="haptic-click w-14 h-14 rounded-full bg-gradient-to-br from-bistro-velvet via-[#290d14] to-bistro-obsidian border-2 border-bistro-gold flex items-center justify-center beacon-glow relative" title="Royal Butler Compass Beacon" aria-label="Royal Butler Service">
        <span class="text-2xl">🔔</span>
        <span class="absolute -top-1 -right-1 flex h-3.5 w-3.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-bistro-gold opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-bistro-gold border border-black text-[8px] font-bold text-black items-center justify-center">IV</span>
        </span>
      </button>
    </div>

    <div id="kitchenStatusModal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden flex items-center justify-center p-4 max-w-md mx-auto">
      <div class="glass-panel-elevated w-full rounded-3xl p-5 sheet-spring-up max-h-[92vh] flex flex-col relative shadow-[0_0_80px_rgba(0,0,0,0.95)]">
        <!-- Close Button -->
        <button onclick="closeKitchenFolioModal()" class="haptic-click absolute right-4 top-4 w-8 h-8 rounded-full bg-bistro-surface border border-bistro-border text-bistro-gold flex items-center justify-center hover:text-white">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>

        <div class="text-left pb-3 border-b border-bistro-border/40">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-bistro-emerald/10 text-bistro-emerald font-mono text-[9px] tracking-wider uppercase border border-bistro-emerald/30 mb-1">
            <span class="w-1.5 h-1.5 rounded-full bg-bistro-emerald animate-ping"></span> LIVE CHEF PASS TELEMETRY
          </span>
          <h3 class="font-cinzel text-xl font-bold text-bistro-goldLight">Table Master Folio</h3>
          <p class="text-[11px] text-bistro-goldLight/60 font-mono">Alcove Suite IV · Executive Chef Raghav</p>
        </div>

        <!-- Master Flight Progress Header with Timer -->
        <div class="my-3 p-3 rounded-2xl bg-bistro-surface/90 border border-bistro-border/60">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="flex items-center gap-1.5 text-bistro-goldLight font-medium">
              <span class="anim-ember text-base">🔥</span> Dishes are on the clay embers
            </span>
            <span class="px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 font-bold text-[10px]">
              IN PROGRESS
            </span>
          </div>
          <div class="flex items-center justify-between text-[11px] font-mono text-bistro-goldLight/60 mt-1.5">
            <span>Estimated pass plating:</span>
            <span class="text-amber-400 font-bold" id="livePassCountdown">~03:42 mins</span>
          </div>
          <!-- Animated Master Progress Bar -->
          <div class="w-full bg-black/60 rounded-full h-1.5 mt-2.5 overflow-hidden border border-bistro-border/30">
            <div class="bg-gradient-to-r from-amber-500 via-bistro-gold to-amber-400 h-full rounded-full gold-sheen-bar" style="width: 68%"></div>
          </div>
        </div>

        <!-- Live Active Dishes with Individual Cooking Animations -->
        <div class="flex-1 overflow-y-auto hide-scroll space-y-2.5 my-2" id="activeKitchenDishesList">
          <!-- Dish 1: Tandoori Oven Animation -->
          <div class="p-3 rounded-2xl bg-bistro-surface/80 border border-bistro-border/50">
            <div class="flex items-start justify-between">
              <div>
                <h4 class="font-cinzel text-xs font-bold text-bistro-goldLight">1× Zafrani Paneer Mille-Feuille</h4>
                <div class="flex items-center gap-1.5 text-[11px] font-mono text-amber-300 mt-1">
                  <span class="anim-ember text-sm">🔥</span>
                  <span>In Tandoor Oven (~3m)</span>
                </div>
              </div>
              <span class="font-mono text-xs font-bold text-bistro-gold">₹490</span>
            </div>
            <div class="w-full bg-black/60 rounded-full h-1 mt-2 overflow-hidden">
              <div class="bg-amber-500 h-full rounded-full animate-pulse" style="width: 60%"></div>
            </div>
          </div>

          <!-- Dish 2: Sautéing / Wok Animation -->
          <div class="p-3 rounded-2xl bg-bistro-surface/80 border border-bistro-border/50">
            <div class="flex items-start justify-between">
              <div>
                <h4 class="font-cinzel text-xs font-bold text-bistro-goldLight">2× Karuveppilai Bay Scallops</h4>
                <div class="flex items-center gap-1.5 text-[11px] font-mono text-emerald-400 mt-1">
                  <span class="anim-steam text-sm">🌿</span>
                  <span>Sautéing with Spices (~2m)</span>
                </div>
              </div>
              <span class="font-mono text-xs font-bold text-bistro-gold">₹1,520</span>
            </div>
            <div class="w-full bg-black/60 rounded-full h-1 mt-2 overflow-hidden">
              <div class="bg-emerald-500 h-full rounded-full" style="width: 78%"></div>
            </div>
          </div>

          <!-- Dish 3: Gold Plating Twinkle Animation -->
          <div class="p-3 rounded-2xl bg-bistro-surface/80 border border-bistro-border/50">
            <div class="flex items-start justify-between">
              <div>
                <h4 class="font-cinzel text-xs font-bold text-bistro-goldLight">1× Murgh Malai Sheekh Kebab</h4>
                <div class="flex items-center gap-1.5 text-[11px] font-mono text-bistro-gold mt-1">
                  <span class="anim-twinkle text-sm">✨</span>
                  <span>Plating at Pass (Finishing Garnish)</span>
                </div>
              </div>
              <span class="font-mono text-xs font-bold text-bistro-gold">₹540</span>
