        desc: 'Slow churned clotted milk ice cream scented with kewra essence, encased in dark chocolate sphere.',
        price: 340, veg: true, satvik: true, glutenFree: true, keto: false,
        pairing: { name: 'Espresso Bean Mist', price: 220 },
        organo: { smoke: 50, saffron: 75, richness: 90 }
      },
      {
        id: 'd19', chapter: 'ch5',
        name: 'Smoked Saffron Old Fashioned',
        desc: 'Bourbon stirred with house-made saffron syrup, Angostura bitters & smoked over aged cinnamon bark.',
        price: 520, veg: true, satvik: true, glutenFree: true, keto: true,
        pairing: { name: 'Signatory Cellar Reserve', price: 0 },
        organo: { smoke: 100, saffron: 85, richness: 60 }
      },
      {
        id: 'd20', chapter: 'ch5',
        name: 'Ratnagiri Alphonso Velvet Lassi',
        desc: 'Thick churned fresh yogurt blended with pure Alphonso mango pulp and roasted pistachio slivers.',
        price: 280, veg: true, satvik: true, glutenFree: true, keto: false,
        pairing: { name: 'Non-Alcoholic Digestive', price: 0 },
        organo: { smoke: 10, saffron: 80, richness: 85 }
      }
    ];

    // ==========================================================
    // CART & TABLE FOLIO STATE MANAGEMENT
    // ==========================================================
    let stagedCart = []; // [{ dish, qty }]
    let activeChapter = 'all';
    let activeDiet = null; // 'satvik' | 'glutenFree' | 'keto' | null

    // Placed orders tracking
    let tableTotalOrder = [
      { name: 'Zafrani Paneer Mille-Feuille', qty: 1, price: 490, guest: 'YOU' },
      { name: 'Karuveppilai Bay Scallops', qty: 2, price: 760, guest: 'GUEST 2' },
      { name: 'Murgh Malai Sheekh Kebab', qty: 1, price: 540, guest: 'YOU' }
    ];

    let currentFolioTab = 'TOTAL'; // 'TOTAL' | 'MY'

    // ==========================================================
    // RENDER DISH MATRIX WITH INLINE SOMMELIER PAIRINGS
    // ==========================================================
    function renderDishes() {
      const container = document.getElementById('dishesMatrix');
      let filtered = DISH_CATALOG.filter(d => {
        const matchChapter = activeChapter === 'all' || d.chapter === activeChapter;
        const matchDiet = !activeDiet || d[activeDiet] === true;
        return matchChapter && matchDiet;
      });

      document.getElementById('dishCountLabel').textContent = `${filtered.length} DISHES SHOWN`;

      if (filtered.length === 0) {
        container.innerHTML = `
          <div class="glass-card rounded-3xl p-8 text-center my-6">
            <span class="text-3xl block mb-2">🌿</span>
            <h4 class="font-cinzel text-base font-bold text-bistro-goldLight">No Dishes in Selected Shield</h4>
            <p class="text-xs text-bistro-goldLight/60 font-light mt-1">Please toggle another dietary filter above.</p>
          </div>
        `;
        return;
      }

      container.innerHTML = filtered.map(dish => {
        const inCart = stagedCart.find(i => i.dish.id === dish.id);
        const qty = inCart ? inCart.qty : 0;

        return `
          <div class="glass-card rounded-3xl p-4 transition-all border border-bistro-border/70 hover:border-bistro-gold/50 shadow-md">
            <!-- Header Badges -->
            <div class="flex items-center justify-between mb-1.5">
              <div class="flex items-center gap-1.5">
                <span class="w-3.5 h-3.5 rounded-sm border ${dish.veg ? 'border-bistro-emerald' : 'border-bistro-flame'} flex items-center justify-center p-0.5">
                  <span class="w-1.5 h-1.5 rounded-full ${dish.veg ? 'bg-bistro-emerald' : 'bg-bistro-flame'}"></span>
                </span>
                ${dish.satvik ? '<span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">SATVIK VERIFIED</span>' : ''}
                ${dish.keto ? '<span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-300 border border-amber-500/20">KETO</span>' : ''}
              </div>
              <span class="font-mono text-sm font-bold text-bistro-gold">₹${dish.price}</span>
            </div>

            <!-- Title & Backstory -->
            <h3 class="font-cinzel text-base font-bold text-bistro-goldLight leading-tight">${dish.name}</h3>
            <p class="text-xs text-bistro-goldLight/70 font-light mt-1 leading-relaxed">${dish.desc}</p>

            <!-- Organoleptic Sensory Bars -->
            <div class="grid grid-cols-3 gap-2 my-2.5 pt-2 border-t border-bistro-border/30 text-[10px] font-mono text-bistro-goldLight/70">
              <div>
                <span class="block text-[8px] uppercase text-bistro-goldLight/50">Smoke: ${dish.organo.smoke}%</span>
                <div class="w-full bg-black/60 rounded-full h-1 mt-0.5 overflow-hidden">
                  <div class="bg-amber-500 h-full rounded-full" style="width: ${dish.organo.smoke}%"></div>
                </div>
              </div>
              <div>
                <span class="block text-[8px] uppercase text-bistro-goldLight/50">Saffron: ${dish.organo.saffron}%</span>
                <div class="w-full bg-black/60 rounded-full h-1 mt-0.5 overflow-hidden">
                  <div class="bg-bistro-gold h-full rounded-full" style="width: ${dish.organo.saffron}%"></div>
                </div>
              </div>
              <div>
                <span class="block text-[8px] uppercase text-bistro-goldLight/50">Richness: ${dish.organo.richness}%</span>
                <div class="w-full bg-black/60 rounded-full h-1 mt-0.5 overflow-hidden">
                  <div class="bg-bistro-velvet h-full rounded-full" style="width: ${dish.organo.richness}%"></div>
                </div>
              </div>
            </div>

            <!-- SALES ACCELERATOR: 1-Tap Sommelier Cellar Pairing Prompt -->
            ${dish.pairing && dish.pairing.price > 0 ? `
              <div class="p-2 rounded-xl bg-bistro-velvet/20 border border-bistro-gold/30 flex items-center justify-between my-2">
                <div class="flex items-center gap-1.5 truncate">
                  <span class="text-base shrink-0">🍷</span>
                  <span class="text-[10px] font-mono text-bistro-goldLight truncate">
                    Sommelier Pairing: <strong class="text-bistro-gold font-semibold">${dish.pairing.name}</strong> (+₹${dish.pairing.price})
                  </span>
                </div>
                <button onclick="addPairingToCart('${dish.pairing.name}', ${dish.pairing.price})" class="haptic-click px-2.5 py-1 rounded-lg bg-bistro-gold text-bistro-void font-mono font-bold text-[9px] uppercase shrink-0 shadow">
                  + PAIR
                </button>
              </div>
            ` : ''}

            <!-- Bottom Add-to-Cart Stepper Action -->
            <div class="flex items-center justify-between pt-2">
              <span class="text-[10px] font-mono text-bistro-emerald flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-bistro-emerald"></span> Verified Cellar Match
              </span>

              ${qty === 0 ? `
                <button onclick="updateDishQty('${dish.id}', 1)" class="haptic-click px-4 py-1.5 rounded-xl bg-gradient-to-r from-bistro-surface to-bistro-elevated border border-bistro-gold text-bistro-gold font-cinzel font-bold text-xs uppercase tracking-wider hover:bg-bistro-gold hover:text-bistro-void transition-all shadow-md">
                  + ADD TO CART
                </button>
              ` : `
                <div class="flex items-center bg-bistro-elevated border border-bistro-gold rounded-xl px-2 py-0.5 text-xs">
                  <button onclick="updateDishQty('${dish.id}', -1)" class="haptic-click text-bistro-gold px-2 py-1 font-bold text-sm">-</button>
                  <span class="font-mono px-2 text-bistro-goldLight font-bold">${qty}</span>
                  <button onclick="updateDishQty('${dish.id}', 1)" class="haptic-click text-bistro-gold px-2 py-1 font-bold text-sm">+</button>
                </div>
              `}
            </div>
          </div>
        `;
      }).join('');
    }

    // ==========================================================
    // CART & DEGUSTATION ACTIONS
    // ==========================================================
    function updateDishQty(dishId, delta) {
      initAudio();
      const dish = DISH_CATALOG.find(d => d.id === dishId);
      if (!dish) return;

      const idx = stagedCart.findIndex(i => i.dish.id === dishId);
      if (idx > -1) {
        stagedCart[idx].qty += delta;
        if (stagedCart[idx].qty <= 0) stagedCart.splice(idx, 1);
      } else if (delta > 0) {
        stagedCart.push({ dish, qty: 1 });
      }

      updateStagingDock();
      renderDishes();
    }

    function addPairingToCart(pairingName, price) {
      playCrystalClink();
      // Add custom pairing item to staging
      const pairingItem = {
        id: 'pair_' + Date.now(),
        name: pairingName,
        desc: 'Sommelier Recommended Vintage Beverage',
        price: price,
        veg: true, satvik: true
      };
      stagedCart.push({ dish: pairingItem, qty: 1 });
      updateStagingDock();
      openCartReviewSheet();
    }

    function addTastingFlightToCart() {
      playCrystalClink();
      const flightDish = {
        id: 'flight_degustation',
        name: 'Royal Awadhi Grand Degustation (3-Courses)',
        desc: 'Zafrani Paneer, 24K Dal Bukhara & Shahi Tukda 24K with Cellar Pairings',
        price: 1420,
        veg: true, satvik: true
      };
      stagedCart.push({ dish: flightDish, qty: 1 });
      updateStagingDock();
      openCartReviewSheet();
    }

    function updateStagingDock() {
      const dock = document.getElementById('stagingCartDock');
      const totalQty = stagedCart.reduce((sum, i) => sum + i.qty, 0);
      const totalVal = stagedCart.reduce((sum, i) => sum + (i.dish.price * i.qty), 0);

      if (totalQty > 0) {
        dock.classList.remove('translate-y-48');
        document.getElementById('cartStagingCount').textContent = `${totalQty} DISH${totalQty > 1 ? 'ES' : ''} IN STAGING`;
        document.getElementById('cartStagingTotal').textContent = `₹${totalVal.toLocaleString()}`;
      } else {
        dock.classList.add('translate-y-48');
      }
    }

    function openCartReviewSheet() {
      const list = document.getElementById('cartStagedList');
      const subtotal = stagedCart.reduce((sum, i) => sum + (i.dish.price * i.qty), 0);

      list.innerHTML = stagedCart.map(item => `
        <div class="py-2 flex items-center justify-between text-xs">
          <div>
            <h5 class="font-cinzel text-xs font-bold text-bistro-goldLight">${item.dish.name}</h5>
            <span class="font-mono text-[11px] text-bistro-gold">₹${item.dish.price} × ${item.qty}</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs font-bold text-bistro-goldLight">₹${item.dish.price * item.qty}</span>
            <button onclick="updateDishQty('${item.dish.id}', -1); openCartReviewSheet();" class="w-6 h-6 rounded bg-bistro-surface text-bistro-gold font-bold">-</button>
            <button onclick="updateDishQty('${item.dish.id}', 1); openCartReviewSheet();" class="w-6 h-6 rounded bg-bistro-surface text-bistro-gold font-bold">+</button>
          </div>
        </div>
      `).join('');

      document.getElementById('reviewStagingSubtotal').textContent = `₹${subtotal.toLocaleString()}`;
      document.getElementById('reviewStagingTotal').textContent = `₹${subtotal.toLocaleString()}`;

      document.getElementById('cartReviewModal').classList.remove('hidden');
    }

    function closeCartReviewSheet() {
      document.getElementById('cartReviewModal').classList.add('hidden');
    }

    function dispatchStagedOrderToKitchen() {
      if (stagedCart.length === 0) return;
      playTibetanGong();

      // Append staged items into total table order marked as 'YOU'
      stagedCart.forEach(item => {
        tableTotalOrder.push({
          name: item.dish.name,
          qty: item.qty,
          price: item.dish.price,
          guest: 'YOU'
        });
      });

      // Clear staged tray
      stagedCart = [];
      updateStagingDock();
      closeCartReviewSheet();
      renderDishes();

      // Update HUD count
      document.getElementById('folioCountBadge').textContent = tableTotalOrder.length;
      document.getElementById('ambientPillSub').textContent = `${tableTotalOrder.length} dishes in kitchen prep`;

      // Launch Live Kitchen preparation telemetry
      openKitchenFolioModal();
    }

    // ==========================================================
    // DEDICATED BILL FOLIO & EQUAL SPLIT RULER
    // ==========================================================
    function openBillFolioModal() {
      initAudio();
      renderFolioContent();
      document.getElementById('billFolioModal').classList.remove('hidden');
    }

    function closeBillFolioModal() {
      document.getElementById('billFolioModal').classList.add('hidden');
    }

    function setFolioTab(tab) {
      currentFolioTab = tab;
      const btnTotal = document.getElementById('tabBtnTotal');
      const btnMy = document.getElementById('tabBtnMy');
      const splitSection = document.getElementById('equalSplitContainer');

      if (tab === 'TOTAL') {
        btnTotal.className = "py-2 rounded-lg bg-bistro-gold text-bistro-void font-bold shadow transition-all";
        btnMy.className = "py-2 rounded-lg text-bistro-goldLight/70 hover:text-white font-medium transition-all";
        // STRICT RULE: EQUAL SPLIT RULER IS VISIBLE ONLY INSIDE TOTAL ORDER
        splitSection.classList.remove('hidden');
      } else {
        btnMy.className = "py-2 rounded-lg bg-bistro-gold text-bistro-void font-bold shadow transition-all";
        btnTotal.className = "py-2 rounded-lg text-bistro-goldLight/70 hover:text-white font-medium transition-all";
        // STRICT RULE: EQUAL SPLIT RULER IS COMPLETELY HIDDEN INSIDE MY ORDER
        splitSection.classList.add('hidden');
      }
      renderFolioContent();
    }

    function renderFolioContent() {
      const container = document.getElementById('folioItemsList');
      const items = currentFolioTab === 'TOTAL' 
        ? tableTotalOrder 
        : tableTotalOrder.filter(i => i.guest === 'YOU');

      if (items.length === 0) {
        container.innerHTML = `<div class="text-center py-4 text-bistro-goldLight/60">No dishes recorded under your name.</div>`;
      } else {
        container.innerHTML = items.map(item => `
          <div class="py-1.5 flex items-center justify-between">
            <div>
              <span class="text-bistro-goldLight">${item.qty}× ${item.name}</span>
              ${currentFolioTab === 'TOTAL' ? `<span class="text-[9px] px-1 py-0.2 rounded bg-bistro-surface border border-bistro-border text-bistro-gold ml-1.5">${item.guest}</span>` : ''}
            </div>
            <span class="text-bistro-gold font-bold">₹${(item.price * item.qty).toLocaleString()}</span>
          </div>
        `).join('');
      }

      const subtotal = items.reduce((sum, i) => sum + (i.price * i.qty), 0);
      const cgst = subtotal * 0.025;
      const sgst = subtotal * 0.025;
      const grandTotal = Math.round(subtotal + cgst + sgst);

      document.getElementById('folioSubtotalVal').textContent = `₹${subtotal.toLocaleString()}`;
      document.getElementById('folioCgstVal').textContent = `₹${cgst.toFixed(2)}`;
      document.getElementById('folioSgstVal').textContent = `₹${sgst.toFixed(2)}`;
      document.getElementById('folioGrandTotal').textContent = `₹${grandTotal.toLocaleString()}`;

      // Update Split ruler based on current total
      handleSplitRulerChange(document.getElementById('splitSlider').value);
    }

    function handleSplitRulerChange(persons) {
      persons = parseInt(persons);
      document.getElementById('splitCountDisplay').textContent = `${persons} PERSONS`;

      // Calculate total table grand total
      const tableSub = tableTotalOrder.reduce((sum, i) => sum + (i.price * i.qty), 0);
      const grandTotal = Math.round(tableSub * 1.05);

      const perPerson = Math.ceil(grandTotal / persons);
      document.getElementById('perPersonShareAmount').textContent = `₹${perPerson.toLocaleString()}`;
    }

    function requestServerCheck() {
      playTibetanGong();
      alert('Captain Vikram paged for Final Settlement. Bringing the wireless card terminal and master portfolio to Alcove Suite IV.');
      closeBillFolioModal();
    }

    // ==========================================================
    // KITCHEN PREPARATION MODAL & BUTLER BEACON
    // ==========================================================
    function openKitchenFolioModal() {
      initAudio();
      document.getElementById('kitchenStatusModal').classList.remove('hidden');
    }

    function closeKitchenFolioModal() {
      document.getElementById('kitchenStatusModal').classList.add('hidden');
    }

    function toggleButlerModal(show) {
      initAudio();
      document.getElementById('butlerServiceModal').classList.toggle('hidden', !show);
      document.getElementById('butlerNotificationBanner').classList.add('hidden');
    }

    function triggerButlerAction(action) {
      playTibetanGong();
      const banner = document.getElementById('butlerNotificationBanner');
      const text = document.getElementById('butlerNoticeText');
      banner.classList.remove('hidden');

      if (action === 'Call Waiter') {
        text.textContent = 'Captain Vikramaditya dispatched to Alcove Suite IV. Estimated arrival: 00:38.';
      } else if (action === 'Need Water') {
        text.textContent = 'Himalayan Spring Water service alerted. Steward is arriving with crystal decanter.';
      } else if (action === 'Need Cutlery') {
        text.textContent = 'Silverware and warm linen napkins are being fetched for your table.';
      } else if (action === 'Valet Car') {
        text.textContent = 'Chauffeur token #B-18 requested. Your vehicle is staging at the main portico.';
      }
    }

    function toggleDietShield(dietType) {
      initAudio();
      const btnSatvik = document.getElementById('shieldBtnSatvik');
      const btnGluten = document.getElementById('shieldBtnGluten');
      const btnKeto = document.getElementById('shieldBtnKeto');

      if (activeDiet === dietType) {
        activeDiet = null;
      } else {
        activeDiet = dietType;
      }

      // Update button styling
      [btnSatvik, btnGluten, btnKeto].forEach(btn => {
        btn.className = "haptic-click px-2.5 py-1 rounded-full text-[10px] font-mono border border-bistro-border bg-bistro-surface text-bistro-goldLight/70 flex items-center gap-1 shrink-0 transition-all";
      });

      if (activeDiet === 'satvik') {
        btnSatvik.className = "haptic-click px-2.5 py-1 rounded-full text-[10px] font-mono border border-emerald-500 bg-emerald-500/20 text-emerald-300 font-bold flex items-center gap-1 shrink-0 transition-all shadow";
      } else if (activeDiet === 'glutenFree') {
        btnGluten.className = "haptic-click px-2.5 py-1 rounded-full text-[10px] font-mono border border-bistro-gold bg-bistro-gold/20 text-bistro-gold font-bold flex items-center gap-1 shrink-0 transition-all shadow";
      } else if (activeDiet === 'keto') {
        btnKeto.className = "haptic-click px-2.5 py-1 rounded-full text-[10px] font-mono border border-amber-500 bg-amber-500/20 text-amber-300 font-bold flex items-center gap-1 shrink-0 transition-all shadow";
      }

      renderDishes();
    }

    function filterChapter(chap) {
      activeChapter = chap;
      document.querySelectorAll('.chapter-btn').forEach(btn => {
        btn.classList.remove('active', 'bg-bistro-gold', 'text-bistro-void');
        btn.classList.add('bg-bistro-surface', 'border', 'border-bistro-border', 'text-bistro-goldLight/80');
      });
      event.target.classList.add('active', 'bg-bistro-gold', 'text-bistro-void');
      event.target.classList.remove('bg-bistro-surface', 'border', 'border-bistro-border', 'text-bistro-goldLight/80');
      renderDishes();
    }

    // Initialize on DOM load
    window.addEventListener('DOMContentLoaded', () => {
      renderDishes();
      handleSplitRulerChange(2);
    });
  </script>
</body>
</html>
